{
  "name": "geogebra-quick-rename",
  "version": "1.0.0",
  "description": "GeoGebra Desktop with Quick Right-Click Point Renaming",
  "main": "main.js",
  "scripts": {
    "start": "node run-electron.js",
    "mcp": "node mcp-server.js",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "geogebra",
    "electron",
    "math",
    "geometry",
    "quick-rename"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.geogebra.quickrename",
    "productName": "GeoGebra Quick Rename",
    "files": [
      "**/*",
      "!geogebra-offline/GeoGebra/HTML5/5.0/web{,/**}",
      "!geogebra-offline/GeoGebra/HTML5/5.0/webSimple{,/**}",
      "!test{,/**}",
      "!benchmark-bridge.js",
      "!*.log",
      "!start-geogebra.bat",
      "!README.md",
      "!measure.ps1",
      "!OPTIMIZE_REPORT.md"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
